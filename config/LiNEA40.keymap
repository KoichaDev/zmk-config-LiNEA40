#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// keep these in sync with the declaration order of layers below (0-indexed) after editing via keymap-editor

#define WINDOWS_NAV 1
#define MAC_DEFAULT 2
#define MAC_NAV 3
#define MOUSE 4
#define FUNCTION 5
#define SCROLL 6
#define WIRELESS 7
#define WIN_EXTRA 8
#define MAC_EXTRA 9

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

// resolve tap immediately on release instead of waiting on hold-preferred default

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <150>;
    quick-tap-ms = <100>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,,,,,,,,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        ZenkakuHankaku {
            bindings = <&kp GRAVE>;
            key-positions = <11 12>;
        };

        DeleteKey {
            bindings = <&kp DEL>;
            key-positions = <7 8>;
        };

        InsertKey {
            bindings = <&kp INS>;
            key-positions = <6 7>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <27 28>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <26 27>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        // scoped to this key only, so Space/other layer-taps keep normal hold behavior
        // longer tapping-term (not require-prior-idle-ms) guards against incidental lingering without blocking rapid re-holds

        mouse_lt: mouse_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        windows_layer {
            bindings = <
&mouse_lt 4 TAB   &kp W            &kp E           &kp R   &kp T                             &kp Y             &kp U  &kp I                &kp O         &kp P
&lt WIN_EXTRA A   &kp S            &kp D           &kp F   &kp G                             &mt LEFT_SHIFT H  &kp J  &kp K                &kp L         &kp SEMICOLON
&mt LEFT_SHIFT Z  &kp X            &kp C           &kp V   &kp B                             &kp N             &kp M  &kp COMMA            &kp DOT       &kp SLASH
&kp SQT           &kp Q            &kp LEFT_SHIFT  &trans  &kp LCTRL  &kp LALT    &kp ENTER  &lt 1 SPACE              &lt 7 RIGHT_BRACKET  &kp CAPSLOCK  &kp LBKT
            >;
        };

        windows_nav {
            bindings = <
&kp NUMBER_0    &kp N1             &kp N2        &kp N3        &kp NUBS                                   &kp BACKSPACE   &kp DELETE      &kp UP_ARROW    &kp HOME         &kp END
&kp ESCAPE      &kp NUMBER_4       &kp NUMBER_5  &kp N6        &kp GRAVE                                  &kp LEFT_SHIFT  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp BACKSLASH
&kp LEFT_SHIFT  &kp NUMBER_7       &kp NUMBER_8  &kp NUMBER_9  &kp MINUS                                  &kp LC(X)       &kp LC(C)       &kp CAPS        &kp LC(V)        &kp BACKSLASH
&kp EQUAL       &kp RIGHT_BRACKET  &kp NUMBER_0  &kp INS       &kp LCTRL  &kp RIGHT_ALT    &kp BACKSLASH  &trans                          &trans          &trans           &tog 2
            >;

            sensor-bindings = <&inc_dec_kp LG(LC(RIGHT_ARROW)) LC(LG(LEFT_ARROW))>;
        };

        MAC_DEFAULT {
            bindings = <
&mouse_lt 4 TAB   &kp W            &kp E           &kp R   &kp T                                    &kp Y             &kp U  &kp I      &kp O         &kp P
&lt MAC_EXTRA A   &kp S            &kp D           &kp F   &kp G                                    &mt LEFT_SHIFT H  &kp J  &kp K      &kp L         &kp SEMICOLON
&mt LEFT_SHIFT Z  &kp X            &kp C           &kp V   &kp B                                    &kp N             &kp M  &kp COMMA  &kp DOT       &kp SLASH
&kp SQT           &kp Q            &kp LEFT_SHIFT  &trans  &kp LEFT_WIN  &kp LEFT_ALT    &kp ENTER  &lt 3 SPACE              &trans     &kp CAPSLOCK  &kp LBKT
            >;
        };

        MAC_NAV {
            bindings = <
&kp NUMBER_0    &kp N1             &kp N2        &kp N3        &kp GRAVE                                         &kp BACKSPACE   &kp RG(BACKSPACE)  &kp UP_ARROW         &kp HOME         &kp END
&kp ESCAPE      &kp NUMBER_4       &kp NUMBER_5  &kp N6        &kp RIGHT_BRACKET                                 &kp LEFT_SHIFT  &kp LEFT_ARROW     &kp DOWN_ARROW       &kp RIGHT_ARROW  &kp NUBS
&kp LEFT_SHIFT  &kp NUMBER_7       &kp NUMBER_8  &kp NUMBER_9  &kp MINUS                                         &kp LG(X)       &kp LG(C)          &trans               &kp LG(V)        &trans
&kp EQUAL       &kp RIGHT_BRACKET  &kp NUMBER_0  &kp INS       &kp LEFT_WIN       &kp LEFT_ALT    &kp BACKSLASH  &trans                             &lt 7 RIGHT_BRACKET  &kp CAPSLOCK     &to 0
            >;

            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        MOUSE {
            bindings = <
&none  &kp F1   &kp F2   &kp F3   &trans                                     &kp C_VOLUME_UP    &none      &mkp MCLK  &kp LC(Z)  &kp LC(Y)
&none  &kp F4   &kp F5   &kp F6   &trans                                     &kp C_VOLUME_DOWN  &mkp LCLK  &lt 6 TAB  &mkp RCLK  &none
&none  &kp F7   &kp F8   &kp F9   &trans                                     &kp C_MUTE         &none      &none      &none      &none
&none  &kp F10  &kp F11  &kp F12  &kp LCTRL  &kp LEFT_SHIFT    &kp LEFT_ALT  &trans                        &trans     &none      &none
            >;
        };

        FUNCTION {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5                     &trans      &trans  &kp LA(PRINTSCREEN)  &trans  &kp LC(LA(DELETE))
&kp F6  &kp F7  &kp F8  &kp F9   &kp F10                    &trans      &trans  &kp LS(LG(S))        &trans  &kp LC(LS(ESCAPE))
&trans  &trans  &trans  &kp F11  &kp F12                    &kp C_MUTE  &trans  &trans               &trans  &kp LC(LA(INS))
&trans  &trans  &trans  &trans   &trans   &trans    &trans  &trans              &trans               &trans  &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        SCROLL {
            bindings = <
&trans    &kp LC(LG(LEFT_ARROW))  &kp UP_ARROW  &kp LC(LG(RIGHT_ARROW))  &trans                    &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_PLUS
&trans    &kp LEFT_ARROW          &kp DOWN      &kp RIGHT_ARROW          &trans                    &kp KP_SLASH     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MINUS
&kp HOME  &kp PAGE_DOWN           &kp END       &kp PAGE_UP              &trans                    &kp UNDER        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ENTER
&trans    &trans                  &trans        &trans                   &trans  &trans    &trans  &kp NUMBER_0                   &kp NUMBER_0  &kp DOT       &kp QUESTION
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        WIRELESS {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans                         &trans          &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans                         &trans          &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &studio_unlock                &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        win_extra {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans        &trans  &trans  &kp LC(Z)  &kp LC(Y)
&trans  &trans  &trans  &trans  &trans                    &trans        &trans  &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans                    &trans        &trans  &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp LEFT_WIN          &trans  &trans     &trans
            >;
        };

        mac_extra {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &kp LG(Z)  &kp LG(LS(Z))
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans  &trans     &trans
            >;
        };
    };
};
